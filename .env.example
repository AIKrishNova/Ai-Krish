# NEXUS AI - placeholders only. Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_NAME=NEXUS AI
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# REQUIRED. PostgreSQL via psycopg, e.g. postgresql+psycopg://user:pass@localhost:5432/nexus
DATABASE_URL=
# OPTIONAL
REDIS_URL=

# NVIDIA NIM (optional for startup; REQUIRED for AI inference).
# Take the base URL, auth scheme and model IDs from the current official NVIDIA API docs.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_DEFAULT_MODEL=
# Hosts the provider URL may point to (SSRF guard), comma separated suffixes
PROVIDER_ALLOWED_HOST_SUFFIXES=.nvidia.com
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3

# OPTIONAL (web research, Phase 3)
SEARCH_API_KEY=
STORAGE_PATH=./storage
