# Copy this file to .env.local and fill in your own values. NEVER commit .env.local.
# Placeholders only. Real keys stay on your machine and in your host's Environment Variables.

# --- Sign-in (Supabase). These two are public by design. Never use the secret/service-role key here. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Access ---
APP_PASSCODE=choose-a-long-passcode
# ALLOW_OPEN_ACCESS=false

# --- AI providers (set at least one) ---
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# MISTRAL_API_KEY=
# MISTRAL_MODEL=
# FREELLMAPI_KEY=
# FREELLMAPI_URL=
# PROVIDER_ORDER=gemini,groq,cerebras
# PROVIDER_TIMEOUT_MS=
# STREAM_IDLE_MS=

# --- Photos and documents ---
# GEMINI_VISION_MODEL=
# GEMINI_VISION_MODELS=
# VISION_PROVIDER_ORDER=gemini,groq,openrouter,mistral
# VISION_TIMEOUT_MS=
# THINK_MAX_STEPS=
# MAX_IMAGES_PER_MESSAGE=
# MAX_IMAGE_BYTES=
# MAX_UPLOAD_BYTES=
# MAX_REQUEST_BYTES=
# MAX_DOCS_PER_MESSAGE=
# DOC_MAX_CHARS=
# DOC_MAX_TOTAL_CHARS=

# --- Rate limits ---
