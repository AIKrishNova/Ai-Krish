# Copy this file to .env.local and fill in your own values. NEVER commit .env.local.
# Placeholders only. Real keys stay on your machine and in Vercel's Environment Variables.

# --- Access (required in production) ---
APP_PASSCODE=choose-a-long-passcode
# ALLOW_OPEN_ACCESS=false          # leave unset. "true" lets /api/analyze run in production with no passcode.

# --- AI providers (set at least the ones you use) ---
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
CEREBRAS_API_KEY=your-cerebras-key
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# PROVIDER_ORDER=gemini,groq,cerebras
# GEMINI_MODEL=

# --- Photo analysis ---
# Gemini is used for images when GEMINI_API_KEY is set. Override the model if you like:
# GEMINI_VISION_MODEL=
# Fallback list: if one model is busy or rate limited, the next is tried (overrides GEMINI_VISION_MODEL):
# GEMINI_VISION_MODELS=model-one,model-two
# Other providers are used for images ONLY if you name a vision model yourself AND have its key:
# GROQ_VISION_MODEL=
# OPENROUTER_VISION_MODEL=
# MISTRAL_VISION_MODEL=
# VISION_PROVIDER_ORDER=gemini,groq,openrouter,mistral
# VISION_TIMEOUT_MS=30000
# THINK_MAX_STEPS=4                 # Think Harder: 2 = observe + answer, 3 = + check, 4 = + correct

# --- Limits (defaults shown) ---
# MAX_IMAGES_PER_MESSAGE=4
# MAX_IMAGE_BYTES=4000000
# MAX_UPLOAD_BYTES=4000000          # Vercel rejects request bodies above about 4.5 MB
# ANALYZE_RATE_PER_MIN=10

# Sign-in (Supabase). Placeholders only. Real values go in .env.local and Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- More optional settings the code reads (all placeholders) ---
# GROQ_MODEL=
# CEREBRAS_MODEL=
# OPENROUTER_MODEL=
# MISTRAL_MODEL=
# FREELLMAPI_KEY=
# FREELLMAPI_URL=
# PROVIDER_TIMEOUT_MS=
# STREAM_IDLE_MS=
# MAX_REQUEST_BYTES=
# MAX_DOCS_PER_MESSAGE=
# DOC_MAX_CHARS=
# DOC_MAX_TOTAL_CHARS=
# DOCS_RATE_PER_MIN=
