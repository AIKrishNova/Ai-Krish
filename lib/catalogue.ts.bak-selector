// Provider-aware instrument catalogue for Jarvis.
//
// Rules this file enforces:
//  - "name" is what you see; "providerSymbol" is what a data provider understands. They are separate.
//  - Only instruments with an integrated provider AND a provider symbol are "live".
//  - Olymp Trade has no public, documented price feed, so Olymp Trade instruments
//    (OTC, composites, broker-specific assets) are listed as "provider_required".
//    They are NEVER silently mapped to Binance or any other lookalike price.

export type AssetClass =
  | "forex" | "stock" | "crypto" | "metal" | "commodity"
  | "index" | "etf" | "otc" | "composite";

export type ProviderId = "binance" | null;

export type MappingStatus =
  | "provider_symbol_verified" // symbol exists on that provider's own market
  | "unverified";              // listed for reference only, no feed

export interface Asset {
  id: string;
  name: string;
  assetClass: AssetClass;
  providerSymbol: string | null;
  provider: ProviderId;
  isOtcOrSynthetic: boolean;
  mapping: MappingStatus;
  modes: ("fixed-time" | "inzone" | "forex" | "stocks")[];
  note?: string;
}

export const BINANCE_TIMEFRAMES = ["1m", "3m", "5m", "15m", "30m", "1h", "4h", "1d"] as const;
export type Timeframe = (typeof BINANCE_TIMEFRAMES)[number];

const crypto = (id: string, name: string, sym: string): Asset => ({
  id, name: `${name} (Binance spot)`, assetClass: "crypto",
  providerSymbol: sym, provider: "binance", isOtcOrSynthetic: false,
  mapping: "provider_symbol_verified", modes: ["fixed-time"],
  note: "Binance market price. Not an Olymp Trade quote.",
});

const reference = (id: string, name: string, assetClass: AssetClass, otc = false): Asset => ({
  id, name, assetClass, providerSymbol: null, provider: null,
  isOtcOrSynthetic: otc || assetClass === "composite", mapping: "unverified",
  modes: [], note: "Live feed unavailable. Provider integration required.",
});

export const CATALOGUE: Asset[] = [
  // Live today (Binance public market data)
  crypto("btc", "Bitcoin", "BTCUSDT"),
  crypto("eth", "Ethereum", "ETHUSDT"),
  crypto("bnb", "BNB", "BNBUSDT"),
  crypto("sol", "Solana", "SOLUSDT"),
  crypto("xrp", "XRP", "XRPUSDT"),
  crypto("ltc", "Litecoin", "LTCUSDT"),
  crypto("doge", "Dogecoin", "DOGEUSDT"),

  // Named in your Olymp Trade screenshots. No authorised feed is integrated yet.
  reference("eurusd", "EUR/USD", "forex"),
  reference("gbpusd", "GBP/USD", "forex"),
  reference("usdjpy", "USD/JPY", "forex"),
  reference("audusd", "AUD/USD", "forex"),
  reference("usdcad", "USD/CAD", "forex"),
  reference("usdchf", "USD/CHF", "forex"),
  reference("nzdusd", "NZD/USD", "forex"),
  reference("aapl", "Apple", "stock"),
  reference("tsla", "Tesla", "stock"),
  reference("msft", "Microsoft", "stock"),
  reference("amzn", "Amazon", "stock"),
  reference("googl", "Alphabet", "stock"),
  reference("nvda", "NVIDIA", "stock"),
  reference("sbux", "Starbucks", "stock"),
  reference("v", "Visa", "stock"),
  reference("gold", "Gold", "metal"),
  reference("silver", "Silver", "metal"),
  reference("oil", "Oil", "commodity"),
  reference("btc-otc", "Bitcoin OTC", "otc", true),
  reference("eurusd-otc", "EUR/USD OTC", "otc", true),
  reference("gold-otc", "Gold OTC", "otc", true),
  reference("asia-comp", "Asia Composite Index", "composite", true),
  reference("metal-comp", "Metal Composite Index", "composite", true),
  reference("oil-comp", "Oil Composite Index", "composite", true),
  reference("crypto-comp", "Crypto Composite Index", "composite", true),
  reference("compound", "Compound Index", "composite", true),
];

export const isLive = (a: Asset) => a.provider !== null && a.providerSymbol !== null;

export function unavailableReason(a: Asset): string | null {
  if (isLive(a)) return null;
  return a.isOtcOrSynthetic
    ? "Broker-specific instrument. Live feed unavailable. Provider integration required."
    : "No data provider is connected for this instrument yet.";
}

export function search(q: string, cls?: AssetClass | "all") {
  const s = q.trim().toLowerCase();
  return CATALOGUE.filter(
    (a) =>
      (!cls || cls === "all" || a.assetClass === cls) &&
      (!s || a.name.toLowerCase().includes(s) || (a.providerSymbol ?? "").toLowerCase().includes(s))
  );
}
