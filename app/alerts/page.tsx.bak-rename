"use client";

import { useEffect, useRef, useState } from "react";
import { INTERVAL_MS, STRATEGY, type Result, type Vote } from "../../lib/market";
import CandleChart from "./CandleChart";
import AssetPicker from "./AssetPicker";
import { CATALOGUE, getStatus, isLive, STATUS_LABEL, unavailableReason, type Asset } from "../../lib/catalogue";

type Api = {
  symbol: string;
  interval: string;
  source: string;
  fetchedAt: number;
  fresh: boolean;
  price: number;
  formingTime: number;
  early: Result;
  confirmed: Result;
};
type Entry = { time: string; text: string; kind: string };
type Settings = { voice: boolean; sound: boolean; notify: boolean; early: boolean; confirmed: boolean };

const TONES: Record<string, number[]> = {
  EARLY_UP: [660, 880],
  CONFIRMED_UP: [660, 880, 1100],
  EARLY_DOWN: [440, 330],
  CONFIRMED_DOWN: [440, 330, 220],
  INVALID: [300, 300],
  STALE: [200, 200, 200],
};
const LABEL: Record<string, string> = {
  "1m": "one-minute",
  "3m": "three-minute",
  "5m": "five-minute",
  "15m": "fifteen-minute",
  "30m": "thirty-minute",
  "1h": "one-hour",
  "4h": "four-hour",
  "1d": "daily",
};
const VOTE_STYLE: Record<Vote, string> = {
  BULL: "text-green-400",
  BEAR: "text-red-400",
  NEUTRAL: "text-cyan-100/60",
  INVALID: "text-yellow-300",
};

export default function Alerts() {
  const [symbol, setSymbol] = useState("BTCUSDT");
  const [selectedId, setSelectedId] = useState("binance:BTCUSDT");
  const [pickedAsset, setPickedAsset] = useState<Asset | null>(null);
  const [interval, setIntervalValue] = useState("1m");
  const [running, setRunning] = useState(false);
  const [data, setData] = useState<Api | null>(null);
  const [error, setError] = useState("");
  const [log, setLog] = useState<Entry[]>([]);
  const [, setTick] = useState(0);
  const [settings, setSettings] = useState<Settings>({
    voice: true,
    sound: true,
    notify: true,
    early: true,
    confirmed: true,
  });

  const settingsRef = useRef(settings);
  settingsRef.current = settings;
  const ctxRef = useRef<AudioContext | null>(null);
  const alertedEarly = useRef(new Set<string>());
  const earlyPending = useRef<Record<number, string>>({});
  const withdrawn = useRef(new Set<number>());
  const closedHandled = useRef(new Set<number>());
  const firstPoll = useRef(true);
  const staleWarned = useRef(false);
  const lostWarned = useRef(false);

  useEffect(() => {
    try {
      const saved = localStorage.getItem("jarvis-alert-log");
      if (saved) setLog(JSON.parse(saved));
    } catch {}
  }, []);
  useEffect(() => {
    try {
      localStorage.setItem("jarvis-alert-log", JSON.stringify(log.slice(0, 200)));
    } catch {}
  }, [log]);

  function playTones(kind: string) {
    const ctx = ctxRef.current;
    if (!settingsRef.current.sound || !ctx) return;
    (TONES[kind] ?? [600]).forEach((hz, i) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.frequency.value = hz;
      o.connect(g);
      g.connect(ctx.destination);
      const t0 = ctx.currentTime + i * 0.22;
      g.gain.setValueAtTime(0.2, t0);
      g.gain.exponentialRampToValueAtTime(0.001, t0 + 0.2);
      o.start(t0);
      o.stop(t0 + 0.21);
    });
  }

  function raise(kind: string, text: string, body: string) {
    setLog((l) => [{ time: new Date().toLocaleTimeString(), text, kind }, ...l].slice(0, 200));
    playTones(kind);
    const s = settingsRef.current;
    if (s.voice && "speechSynthesis" in window) {
      speechSynthesis.cancel();
      speechSynthesis.speak(new SpeechSynthesisUtterance(text));
    }
    if (s.notify && "Notification" in window && Notification.permission === "granted") {
      try {
        new Notification("Jarvis alert", { body });
      } catch {}
    }
  }

  useEffect(() => {
    if (!running) return;
    let stop = false;
    alertedEarly.current = new Set();
    earlyPending.current = {};
    withdrawn.current = new Set();
    closedHandled.current = new Set();
    firstPoll.current = true;
    staleWarned.current = false;
    lostWarned.current = false;

    function announce(stage: "EARLY" | "CONFIRMED", d: Api, r: Result) {
      const dir = r.direction as "UP" | "DOWN";
      const votes = dir === "UP" ? `${r.bull} of 5 indicators bullish` : `${r.bear} of 5 indicators bearish`;
      const tf = LABEL[d.interval] ?? d.interval;
      const text =
        stage === "EARLY"
          ? `Jarvis alert. Early ${dir} setup detected on ${d.symbol}, ${tf} timeframe. ${votes}. Provisional signal.`
          : `Jarvis confirmation. ${dir} setup confirmed on ${d.symbol}, ${tf} candle close. ${votes}. Manual review required.`;
      const body = `${d.symbol} | ${dir} | ${stage} | ${d.interval} | ${votes} | candle ${new Date(
        r.candleTime
      ).toLocaleTimeString()} | data fresh`;
      raise(`${stage}_${dir}`, text, body);
    }

    async function check() {
      try {
        const res = await fetch(`/api/signal?symbol=${symbol}&interval=${interval}`);
        const d: Api & { error?: string } = await res.json();
        if (stop) return;
        if (d.error) {
          setError(d.error);
          return;
        }
        setError("");
        setData(d);
        lostWarned.current = false;

        if (!d.fresh) {
          if (!staleWarned.current) {
            staleWarned.current = true;
            raise("STALE", "Jarvis warning. Market data is stale. Signals are paused.", "Market data is stale. Signals paused.");
          }
          return;
        }
        staleWarned.current = false;

        const e = d.early;
        const c = d.confirmed;
        const s = settingsRef.current;

        // Early (provisional) setups on the forming candle
        if (e.direction !== "NONE") {
          const key = `${d.formingTime}-${e.direction}`;
          if (!alertedEarly.current.has(key)) {
            alertedEarly.current.add(key);
            if (s.early) {
              earlyPending.current[d.formingTime] = e.direction;
              announce("EARLY", d, e);
            }
          }
        } else {
          const pend = earlyPending.current[d.formingTime];
          if (pend && !withdrawn.current.has(d.formingTime)) {
            withdrawn.current.add(d.formingTime);
            raise(
              "INVALID",
              `Jarvis notice. Early ${pend} setup on ${d.symbol} is no longer valid.`,
              `${d.symbol} | early ${pend} setup withdrawn before candle close`
            );
          }
        }

        // Confirmed setups on the last closed candle
        if (firstPoll.current) {
          closedHandled.current.add(c.candleTime); // do not alert about a candle that closed before watching began
          firstPoll.current = false;
        }
        if (c.candleTime && !closedHandled.current.has(c.candleTime)) {
          closedHandled.current.add(c.candleTime);
          const pend = earlyPending.current[c.candleTime];
          if (pend && pend !== c.direction && !withdrawn.current.has(c.candleTime)) {
            setLog((l) =>
              [
                {
                  time: new Date().toLocaleTimeString(),
                  text: `EARLY ${pend} SETUP FAILED TO CONFIRM on ${d.symbol} (candle ${new Date(c.candleTime).toLocaleTimeString()}).`,
                  kind: "INVALID",
                },
                ...l,
              ].slice(0, 200)
            );
          }
          if (c.direction !== "NONE" && s.confirmed) announce("CONFIRMED", d, c);
        }
      } catch {
        if (stop) return;
        setError("Could not reach the price feed.");
        if (!lostWarned.current) {
          lostWarned.current = true;
          raise("STALE", "Jarvis warning. Connection to market data lost.", "Connection to market data lost.");
        }
      }
    }

    check();
    const t = setInterval(check, 5000);
    const clock = setInterval(() => setTick((x) => x + 1), 1000);
    return () => {
      stop = true;
      clearInterval(t);
      clearInterval(clock);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [running, symbol, interval]);

  function toggle() {
    if (!running) {
      if (!ctxRef.current) {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        ctxRef.current = new AC();
      }
      ctxRef.current.resume();
      if ("Notification" in window && Notification.permission === "default") Notification.requestPermission();
      playTones("EARLY_UP");
    }
    setRunning(!running);
  }

  const selectedAsset = pickedAsset ?? CATALOGUE.find((a) => a.id === selectedId);
  const liveSelected = !selectedAsset || isLive(selectedAsset);
  function pickAsset(a: Asset) {
    setSelectedId(a.id);
    setPickedAsset(a);
    setData(null);
    setError("");
    if (isLive(a) && a.providerSymbol) setSymbol(a.providerSymbol);
    else setRunning(false);
  }

  function flip(key: keyof Settings) {
    setSettings((s) => ({ ...s, [key]: !s[key] }));
  }

  const e = data?.early;
  const c = data?.confirmed;
  const left = data ? Math.max(0, Math.round((data.formingTime + INTERVAL_MS[data.interval] - Date.now()) / 1000)) : null;
  const setupText = !data
    ? "Not watching"
    : !data.fresh
    ? "WAIT: data is stale"
    : e!.direction === "NONE"
    ? "NO SETUP"
    : `EARLY ${e!.direction} (provisional)`;
  const confirmedText = !data
    ? ""
    : c!.direction === "NONE"
    ? "No confirmed setup on the last closed candle"
    : `CONFIRMED ${c!.direction} on the candle that opened at ${new Date(c!.candleTime).toLocaleTimeString()}`;

  return (
    <div className="min-h-screen bg-[#050b18] p-6 text-cyan-50"
      style={{ backgroundImage: "radial-gradient(circle at 30% 10%, #0b2a4a 0%, #050b18 60%)" }}>
      <h1 className="text-2xl font-bold tracking-[0.3em] text-cyan-300">JARVIS MARKET ALERTS</h1>
      <p className="mb-1 text-xs text-cyan-100/60">Strategy: {STRATEGY.version}. Alerts only. Manual review only. No automatic trading.</p>
      <p className="mb-4 text-xs text-yellow-200/80">
        A signal is not a prediction and not a guarantee. This price feed is Binance crypto data, not Olymp Trade prices.
      </p>

      <div className="mb-3 flex flex-wrap items-center gap-3">
        <AssetPicker selectedId={selectedId} symbol={symbol} onSelect={pickAsset} />
        <select value={interval} onChange={(ev) => setIntervalValue(ev.target.value)}
          className="rounded-lg border border-cyan-400/30 bg-black/40 px-3 py-2 text-sm">
          {Object.keys(INTERVAL_MS).map((i) => (
            <option key={i}>{i}</option>
          ))}
        </select>
        <button onClick={toggle} disabled={!liveSelected} style={liveSelected ? undefined : { opacity: 0.4 }} title={liveSelected ? undefined : "Live data unavailable for this asset"}
          className={`rounded-lg px-5 py-2 text-sm font-semibold ${running ? "bg-red-500 text-white" : "bg-cyan-500 text-black"}`}>
          {running ? "Stop watching" : "Start watching"}
        </button>
        {(["voice", "sound", "notify", "early", "confirmed"] as (keyof Settings)[]).map((k) => (
          <button key={k} onClick={() => flip(k)}
            className={`rounded-lg border px-3 py-1 text-xs uppercase ${settings[k] ? "border-cyan-300 bg-cyan-400/20" : "border-cyan-100/20 text-cyan-100/40"}`}>
            {k}: {settings[k] ? "on" : "off"}
          </button>
        ))}
      </div>

      {error && <div className="mb-3 text-sm text-red-300">Error: {error}</div>}
{liveSelected ? (
        <div className="mb-4 h-[640px]"><CandleChart symbol={symbol} interval={interval} /></div>
      ) : (
        <div className="mb-4 rounded-xl border border-yellow-300/30 bg-yellow-300/5 p-4 text-sm text-yellow-100">
          <div className="mb-1 font-semibold">
            {selectedAsset?.name}: {selectedAsset ? STATUS_LABEL[getStatus(selectedAsset)] : ""}
          </div>
          <div>{selectedAsset ? unavailableReason(selectedAsset) : ""}</div>
          <div className="mt-1 text-xs text-yellow-100/70">
            Candles, indicators and alerts are paused for this asset. Pick a Binance crypto pair to see a live chart.
          </div>
        </div>
      )}

      {data && (
        <div className="mb-4 grid gap-3 md:grid-cols-3">
          <div className="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-3 text-sm">
            <div className="text-[10px] uppercase tracking-widest text-cyan-100/50">Market</div>
            <div className="text-lg">{data.symbol} {data.price}</div>
            <div>Timeframe {data.interval}. Candle closes in {left}s</div>
          </div>
          <div className="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-3 text-sm">
            <div className="text-[10px] uppercase tracking-widest text-cyan-100/50">Data status</div>
            <div>{data.source}</div>
            <div>Last update {new Date(data.fetchedAt).toLocaleTimeString()}. {data.fresh ? "Fresh" : "STALE"}</div>
          </div>
          <div className="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-3 text-sm">
            <div className="text-[10px] uppercase tracking-widest text-cyan-100/50">Setup</div>
            <div className="text-lg font-semibold">{setupText}</div>
            <div className="text-xs">{confirmedText}</div>
          </div>
        </div>
      )}

      {data && e && c && (
        <div className="mb-4 overflow-x-auto rounded-xl border border-cyan-400/20">
          <table className="w-full text-left text-sm">
            <thead className="bg-cyan-400/10 text-xs uppercase tracking-widest text-cyan-100/60">
              <tr>
                <th className="p-2">Indicator</th>
                <th className="p-2">Live (forming candle)</th>
                <th className="p-2">Vote</th>
                <th className="p-2">Last closed candle</th>
                <th className="p-2">Vote</th>
              </tr>
            </thead>
            <tbody>
              {e.rows.map((row, i) => (
                <tr key={row.name} className="border-t border-cyan-400/10">
                  <td className="p-2">{row.name}</td>
                  <td className="p-2">{row.value}</td>
                  <td className={`p-2 font-semibold ${VOTE_STYLE[row.vote]}`}>{row.vote}</td>
                  <td className="p-2">{c.rows[i]?.value}</td>
                  <td className={`p-2 font-semibold ${c.rows[i] ? VOTE_STYLE[c.rows[i].vote] : ""}`}>{c.rows[i]?.vote}</td>
                </tr>
              ))}
              <tr className="border-t border-cyan-400/10">
                <td className="p-2">Votes</td>
                <td className="p-2" colSpan={2}>{e.bull} bullish, {e.bear} bearish</td>
                <td className="p-2" colSpan={2}>{c.bull} bullish, {c.bear} bearish</td>
              </tr>
            </tbody>
          </table>
          {e.failures.length > 0 && (
            <div className="border-t border-cyan-400/10 p-2 text-xs text-cyan-100/60">
              Why no setup now: {e.failures.join("; ")}
            </div>
          )}
        </div>
      )}

      <div className="text-xs uppercase tracking-[0.3em] text-cyan-300">Alert history</div>
      <div className="mt-2 space-y-2 text-sm">
        {log.length === 0 && <div className="text-cyan-100/40">No alerts yet.</div>}
        {log.map((x, i) => (
          <div key={i} className={`rounded-lg border p-2 ${x.kind.includes("UP") ? "border-green-400/40" : x.kind.includes("DOWN") ? "border-red-400/40" : "border-yellow-300/30"}`}>
            {x.time} - {x.text}
          </div>
        ))}
      </div>
    </div>
  );
}
