/* eslint-disable @typescript-eslint/no-explicit-any */
"use client";

import { useEffect, useRef, useState, type CSSProperties } from "react";

type Msg = { role: "user" | "jarvis"; text: string };

const MENU = ["Command Center", "AI Core", "Chat", "Tasks", "Memory", "Tools & Skills"];

// Speech engines often hear "Krish" as Chris / Krishna, so accept those too.
const WAKE = /\b(?:hey|hi|hello|ok|okay)[\s,]+(?:krish|krishna|chris|kris|krush|crush)\b[\s,.!?]*/i;

const LOOKS: Record<string, { c1: string; c2: string; glow: string; label: string }> = {
  idle: { c1: "#bfdbfe", c2: "#3b82f6", glow: "rgba(59,130,246,0.35)", label: 'Turn on "Hey Krish" or tap Talk' },
  standby: { c1: "#c7d2fe", c2: "#6366f1", glow: "rgba(99,102,241,0.35)", label: 'Say "Hey Krish"' },
  listening: { c1: "#a7f3d0", c2: "#10b981", glow: "rgba(16,185,129,0.45)", label: "Listening..." },
  thinking: { c1: "#fde68a", c2: "#f59e0b", glow: "rgba(245,158,11,0.40)", label: "Thinking..." },
  speaking: { c1: "#ddd6fe", c2: "#8b5cf6", glow: "rgba(139,92,246,0.45)", label: "Speaking..." },
};

export default function Home() {
  const [messages, setMessages] = useState<Msg[]>([
    { role: "jarvis", text: 'Good day. I am AI Krish. Turn on "Hey Krish" and say my name, or press Talk to AI Krish and speak.' },
  ]);
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [micOpen, setMicOpen] = useState(false);
  const [wakeOn, setWakeOn] = useState(false);
  const [awake, setAwake] = useState(false);
  const [speaking, setSpeaking] = useState(false);
  const [voiceOn, setVoiceOn] = useState(true);
  const [lastProvider, setLastProvider] = useState<string | null>(null);
  const [micError, setMicError] = useState("");
  const [now, setNow] = useState<Date | null>(null);

  const endRef = useRef<HTMLDivElement>(null);
  const recRef = useRef<any>(null);
  const runningRef = useRef(false);
  const wakeRef = useRef(false);
  const oneShotRef = useRef(false);
  const awakeRef = useRef(false);
  const awakeTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const speakingRef = useRef(false);
  const speakEndRef = useRef(0);

  useEffect(() => {
    setNow(new Date());
    const t = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, busy]);

  useEffect(() => {
    return () => {
      wakeRef.current = false;
      try { recRef.current?.stop(); } catch {}
      if (typeof window !== "undefined") window.speechSynthesis?.cancel();
    };
  }, []);

  function speak(text: string) {
    if (!voiceOn || !("speechSynthesis" in window)) return;
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.onstart = () => { speakingRef.current = true; setSpeaking(true); };
    const done = () => { speakingRef.current = false; speakEndRef.current = Date.now(); setSpeaking(false); };
    u.onend = done;
    u.onerror = done;
    window.speechSynthesis.speak(u);
  }

  async function send(textIn?: string) {
    const text = (textIn ?? input).trim();
    if (!text || busy) return;
    const next: Msg[] = [...messages, { role: "user", text }];
    setMessages(next);
    setInput("");
    setBusy(true);
    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: next }),
      });
      const data = await res.json();
      const reply: string = data.reply ?? `Error: ${data.error ?? "no reply"}`;
      setMessages((m) => [...m, { role: "jarvis", text: reply }]);
      if (data.provider) setLastProvider(data.provider);
      if (data.reply) speak(reply);
    } catch {
      setMessages((m) => [...m, { role: "jarvis", text: "Error: could not reach the server." }]);
    }
    setBusy(false);
  }

  const sendRef = useRef(send);
  sendRef.current = send;

  function clearAwake() {
    awakeRef.current = false;
    setAwake(false);
    if (awakeTimer.current) clearTimeout(awakeTimer.current);
  }

  function stopRec() {
    try { recRef.current?.stop(); } catch {}
  }

  function setAwakeNow() {
    awakeRef.current = true;
    setAwake(true);
    if (awakeTimer.current) clearTimeout(awakeTimer.current);
    awakeTimer.current = setTimeout(() => {
      clearAwake();
      if (oneShotRef.current) stopRec();
    }, 9000);
  }

  function handleFinal(text: string) {
    // Ignore anything heard while AI Krish is talking (or just after), so it does not hear itself.
    if (speakingRef.current || Date.now() - speakEndRef.current < 900) return;
    const t = text.trim();
    if (!t) return;
    if (awakeRef.current) {
      clearAwake();
      sendRef.current(t);
      if (oneShotRef.current) stopRec();
      return;
    }
    const m = t.match(WAKE);
    if (m) {
      const rest = t.slice((m.index ?? 0) + m[0].length).trim();
      if (rest.length > 1) sendRef.current(rest);
      else setAwakeNow();
    }
  }

  function startRec(): boolean {
    if (runningRef.current) return true;
    const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (!SR) {
      alert("Voice input needs Google Chrome. Please open this page in Chrome.");
      return false;
    }
    const rec = new SR();
    rec.lang = "en-IN";
    rec.continuous = true;
    rec.interimResults = false;
    rec.onstart = () => { runningRef.current = true; setMicOpen(true); };
    rec.onend = () => {
      runningRef.current = false;
      setMicOpen(false);
      // Chrome stops listening after a quiet spell, so reopen it while "Hey Krish" is on.
      if (wakeRef.current) setTimeout(() => { if (wakeRef.current) startRec(); }, 400);
    };
    rec.onerror = (e: any) => {
      if (e?.error === "not-allowed" || e?.error === "service-not-allowed") {
        wakeRef.current = false;
        setWakeOn(false);
        clearAwake();
        setMicError("Microphone is blocked. Allow it in the browser address bar, then try again.");
      }
    };
    rec.onresult = (e: any) => {
      for (let i = e.resultIndex; i < e.results.length; i++) {
        if (e.results[i].isFinal) handleFinal(e.results[i][0].transcript);
      }
    };
    recRef.current = rec;
    try { rec.start(); } catch {}
    return true;
  }

  function toggleWake() {
    if (wakeOn) {
      wakeRef.current = false;
      setWakeOn(false);
      clearAwake();
      stopRec();
      return;
    }
    setMicError("");
    wakeRef.current = true;
    oneShotRef.current = false;
    setWakeOn(true);
    if (!startRec()) { wakeRef.current = false; setWakeOn(false); }
  }

  function talk() {
    if (awake) {
      clearAwake();
      if (!wakeRef.current) stopRec();
      return;
    }
    setMicError("");
    if ("speechSynthesis" in window) window.speechSynthesis.cancel();
    oneShotRef.current = !wakeRef.current;
    setAwakeNow();
    if (!startRec()) clearAwake();
  }

  const mode = busy ? "thinking" : speaking ? "speaking" : awake ? "listening" : wakeOn ? "standby" : "idle";
  const look = LOOKS[mode];

  const status = [
    { label: "AI Core", value: busy ? "Thinking..." : "Online" },
    { label: "Brain", value: lastProvider ?? "Auto (multi-provider)" },
    { label: "Voice", value: voiceOn ? "On" : "Muted" },
    { label: "Microphone", value: awake ? "Listening" : wakeOn ? 'Waiting for "Hey Krish"' : micOpen ? "Open" : "Idle" },
  ];

  return (
    <div className="flex h-screen bg-slate-50 text-slate-900">
      <style>{`
        .orbwrap{position:relative;width:16rem;height:16rem;display:flex;align-items:center;justify-content:center}
        .orb{position:relative;width:9rem;height:9rem;border-radius:9999px;
          background:radial-gradient(circle at 35% 28%,#fff 0%,var(--c1) 38%,var(--c2) 100%);
          box-shadow:0 0 70px var(--glow),inset 0 -10px 30px rgba(0,0,0,.12);
          transition:background .4s,box-shadow .4s;animation:orb-breathe 4s ease-in-out infinite}
        .ring{position:absolute;inset:3.5rem;border-radius:9999px;border:2px solid var(--c2);opacity:0;pointer-events:none}
        .listening .ring,.speaking .ring{animation:orb-ripple 2.4s ease-out infinite}
        .listening .r2,.speaking .r2{animation-delay:.8s}
        .listening .r3,.speaking .r3{animation-delay:1.6s}
        .standby .orb{animation:orb-breathe 3s ease-in-out infinite}
        .standby .r1{opacity:.3}
        .listening .orb{animation:orb-listen 1.1s ease-in-out infinite}
        .speaking .orb{animation:orb-speak .7s ease-in-out infinite}
        .thinking .orb{animation:orb-breathe 1.2s ease-in-out infinite}
        .thinking .r1{inset:2.5rem;opacity:1;border:3px solid transparent;border-top-color:var(--c2);border-right-color:var(--c2);animation:orb-spin 1s linear infinite}
        .orbtext{position:absolute;font-size:.8rem;font-weight:700;letter-spacing:.3em;color:#1e293b;opacity:.75}
        @keyframes orb-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
        @keyframes orb-listen{0%,100%{transform:scale(1)}50%{transform:scale(1.13)}}
        @keyframes orb-speak{0%,100%{transform:scale(1)}30%{transform:scale(1.09)}60%{transform:scale(.97)}}
        @keyframes orb-ripple{0%{transform:scale(.95);opacity:.55}100%{transform:scale(1.9);opacity:0}}
        @keyframes orb-spin{to{transform:rotate(360deg)}}
      `}</style>

      {/* Sidebar */}
      <aside className="hidden w-56 flex-col border-r border-slate-200 bg-white p-4 md:flex">
        <div className="mb-6 text-lg font-bold tracking-[0.3em] text-blue-600">AI KRISH</div>
        {MENU.map((item) => (
          <div key={item}
            className={`mb-2 rounded-lg px-3 py-2 text-sm ${
              item === "Command Center"
                ? "border border-blue-200 bg-blue-50 text-blue-700"
                : "text-slate-400"
            }`}>
            {item}
            {item !== "Command Center" && <span className="ml-2 text-[10px] uppercase">soon</span>}
          </div>
        ))}
      </aside>

      {/* Main */}
      <main className="flex min-w-0 flex-1 flex-col p-4">
        <header className="mb-4 flex items-center justify-between">
          <div>
            <div className="text-xs tracking-[0.3em] text-blue-600">SYSTEM STATUS: OPTIMAL</div>
            <div className="text-2xl font-semibold">
              {now ? now.toLocaleTimeString() : "--:--:--"}
              <span className="ml-3 text-sm font-normal text-slate-500">
                {now ? now.toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long" }) : ""}
              </span>
            </div>
          </div>
          <div className="flex gap-2">
            <button onClick={toggleWake}
              className={`rounded-lg border px-3 py-1 text-sm ${
                wakeOn
                  ? "border-indigo-300 bg-indigo-50 text-indigo-700"
                  : "border-slate-300 bg-white text-slate-700 hover:bg-slate-100"}`}>
              Hey Krish: {wakeOn ? "On" : "Off"}
            </button>
            <button onClick={() => { if (voiceOn && "speechSynthesis" in window) window.speechSynthesis.cancel(); setVoiceOn(!voiceOn); }}
              className="rounded-lg border border-slate-300 bg-white px-3 py-1 text-sm text-slate-700 hover:bg-slate-100">
              Voice: {voiceOn ? "On" : "Off"}
            </button>
          </div>
        </header>

        {micError && (
          <div className="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{micError}</div>
        )}

        <div className="grid min-h-0 flex-1 gap-4 lg:grid-cols-2">
          {/* Orb + status */}
          <section className="flex min-h-0 flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div className={`orbwrap ${mode}`}
              style={{ "--c1": look.c1, "--c2": look.c2, "--glow": look.glow } as CSSProperties}>
              <span className="ring r1" />
              <span className="ring r2" />
              <span className="ring r3" />
              <div className="orb" />
              <div className="orbtext">KRISH</div>
            </div>
            <div className="mt-1 text-sm font-medium text-slate-600">{look.label}</div>
            <div className="mt-4 grid w-full max-w-md grid-cols-2 gap-3">
              {status.map((s) => (
                <div key={s.label} className="rounded-xl border border-slate-200 bg-slate-50 p-3">
                  <div className="text-[10px] uppercase tracking-widest text-slate-500">{s.label}</div>
                  <div className="text-sm text-slate-800">{s.value}</div>
                </div>
              ))}
            </div>
          </section>

          {/* Chat */}
          <section className="flex min-h-0 flex-col rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div className="mb-2 text-xs uppercase tracking-[0.3em] text-blue-600">Conversation</div>
            <div className="flex-1 space-y-3 overflow-y-auto pr-1">
              {messages.map((m, i) => (
                <div key={i} className={`flex ${m.role === "user" ? "justify-end" : "justify-start"}`}>
                  <div className={`max-w-[85%] whitespace-pre-wrap rounded-2xl px-4 py-2 text-sm ${
                      m.role === "user"
                        ? "bg-blue-600 text-white"
                        : "border border-slate-200 bg-slate-100 text-slate-800"}`}>
                    {m.text}
                  </div>
                </div>
              ))}
              {busy && <div className="animate-pulse text-sm text-slate-500">AI Krish is thinking...</div>}
              <div ref={endRef} />
            </div>
            <div className="mt-3 flex gap-2">
              <input value={input} onChange={(e) => setInput(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && send()}
                placeholder="Type a message..."
                className="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm outline-none placeholder:text-slate-400 focus:border-blue-500" />
              <button onClick={() => send()}
                className="rounded-xl bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-500">
                Send
              </button>
            </div>
          </section>
        </div>

        {/* Talk bar */}
        <button onClick={talk}
          className={`mt-4 rounded-full border px-8 py-3 text-sm font-semibold tracking-[0.3em] ${
            awake
              ? "animate-pulse border-emerald-400 bg-emerald-50 text-emerald-700"
              : "border-blue-300 bg-blue-50 text-blue-700 hover:bg-blue-100"}`}>
          {awake ? "I AM LISTENING... (TAP TO STOP)" : "TALK TO AI KRISH"}
        </button>
      </main>
    </div>
  );
}
