import { GoogleGenAI } from "@google/genai";

const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

function friendly(e: unknown) {
  const raw = e instanceof Error ? e.message : String(e);
  try {
    const j = JSON.parse(raw);
    return j?.error?.message ?? raw;
  } catch {
    return raw;
  }
}

export async function POST(req: Request) {
  try {
    if (!process.env.GEMINI_API_KEY) {
      return Response.json(
        { error: "GEMINI_API_KEY is missing. Save it in .env.local, then restart npm run dev." },
        { status: 500 }
      );
    }
    const { messages } = await req.json();
    const history = (messages as { role: string; text: string }[])
      .filter((m) => !m.text.startsWith("Error:"))
      .slice(-20);
    const firstUser = history.findIndex((m) => m.role === "user");
    const contents = history
      .slice(firstUser === -1 ? 0 : firstUser)
      .map((m) => ({
        role: m.role === "user" ? "user" : "model",
        parts: [{ text: m.text }],
      }));

    const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });
    let lastError: unknown;
    for (let attempt = 0; attempt < 4; attempt++) {
      try {
        const result = await ai.models.generateContent({
          model: "gemini-3.8-flash",
          contents,
          config: {
            systemInstruction:
              "You are AI Krish, a calm, helpful personal AI assistant. Keep answers short and clear (1 to 4 sentences) unless asked for more. Reply in the language the user writes in. Do not claim to have access to any platform, account or data unless it was provided in this conversation.",
          },
        });
        return Response.json({ reply: result.text });
      } catch (e) {
        lastError = e;
        const raw = e instanceof Error ? e.message : String(e);
        const retryable = raw.includes("503") || raw.includes("UNAVAILABLE") || raw.includes("429");
        if (!retryable || attempt === 3) break;
        await sleep(1500 * (attempt + 1));
      }
    }
    return Response.json({ error: friendly(lastError) }, { status: 500 });
  } catch (e) {
    return Response.json({ error: friendly(e) }, { status: 500 });
  }
}
