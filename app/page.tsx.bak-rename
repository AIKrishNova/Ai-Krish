/* eslint-disable @typescript-eslint/no-explicit-any */
"use client";

import { useEffect, useRef, useState } from "react";

type Msg = { role: "user" | "jarvis"; text: string };

const MENU = ["Command Center", "AI Core", "Chat", "Tasks", "Memory", "Tools & Skills"];

export default function Home() {
  const [messages, setMessages] = useState<Msg[]>([
    { role: "jarvis", text: "Good day. I am Jarvis. Type a message, or press Talk to Jarvis and speak." },
  ]);
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [listening, setListening] = useState(false);
  const [voiceOn, setVoiceOn] = useState(true);
  const [now, setNow] = useState<Date | null>(null);
  const endRef = useRef<HTMLDivElement>(null);
  const recRef = useRef<any>(null);

  useEffect(() => {
    setNow(new Date());
    const t = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, busy]);

  function speak(text: string) {
    if (!voiceOn || !("speechSynthesis" in window)) return;
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(new SpeechSynthesisUtterance(text));
  }

  async function send(textIn?: string) {
    const text = (textIn ?? input).trim();
    if (!text || busy) return;
    const next: Msg[] = [...messages, { role: "user", text }];
    setMessages(next);
    setInput("");
    setBusy(true);
    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: next }),
      });
      const data = await res.json();
      const reply: string = data.reply ?? `Error: ${data.error ?? "no reply"}`;
      setMessages((m) => [...m, { role: "jarvis", text: reply }]);
      if (data.reply) speak(reply);
    } catch {
      setMessages((m) => [...m, { role: "jarvis", text: "Error: could not reach the server." }]);
    }
    setBusy(false);
  }

  const sendRef = useRef(send);
  sendRef.current = send;

  function toggleMic() {
    if (listening) {
      recRef.current?.stop();
      return;
    }
    const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (!SR) {
      alert("Voice input needs Google Chrome. Please open this page in Chrome.");
      return;
    }
    const rec = new SR();
    rec.lang = "en-IN";
    rec.interimResults = false;
    rec.onstart = () => setListening(true);
    rec.onend = () => setListening(false);
    rec.onerror = () => setListening(false);
    rec.onresult = (e: any) => sendRef.current(e.results[0][0].transcript);
    recRef.current = rec;
    rec.start();
  }

  const status = [
    { label: "AI Core", value: busy ? "Thinking..." : "Online" },
    { label: "Brain", value: "Gemini (free tier)" },
    { label: "Voice", value: voiceOn ? "On" : "Muted" },
    { label: "Microphone", value: listening ? "Listening" : "Idle" },
  ];

  return (
    <div className="flex h-screen bg-[#050b18] text-cyan-50"
      style={{ backgroundImage: "radial-gradient(circle at 30% 20%, #0b2a4a 0%, #050b18 60%)" }}>
      {/* Sidebar */}
      <aside className="hidden w-56 flex-col border-r border-cyan-400/20 bg-black/30 p-4 md:flex">
        <div className="mb-6 text-lg font-bold tracking-[0.3em] text-cyan-300">JARVIS</div>
        {MENU.map((item) => (
          <div key={item}
            className={`mb-2 rounded-lg px-3 py-2 text-sm ${
              item === "Command Center"
                ? "border border-cyan-400/40 bg-cyan-400/10 text-cyan-200"
                : "text-cyan-100/40"
            }`}>
            {item}
            {item !== "Command Center" && <span className="ml-2 text-[10px] uppercase">soon</span>}
          </div>
        ))}
      </aside>

      {/* Main */}
      <main className="flex min-w-0 flex-1 flex-col p-4">
        <header className="mb-4 flex items-center justify-between">
          <div>
            <div className="text-xs tracking-[0.3em] text-cyan-300">SYSTEM STATUS: OPTIMAL</div>
            <div className="text-2xl font-semibold">
              {now ? now.toLocaleTimeString() : "--:--:--"}
              <span className="ml-3 text-sm font-normal text-cyan-100/60">
                {now ? now.toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long" }) : ""}
              </span>
            </div>
          </div>
          <button onClick={() => setVoiceOn(!voiceOn)}
            className="rounded-lg border border-cyan-400/40 px-3 py-1 text-sm hover:bg-cyan-400/10">
            Voice: {voiceOn ? "On" : "Off"}
          </button>
        </header>

        <div className="grid min-h-0 flex-1 gap-4 lg:grid-cols-2">
          {/* Core + status */}
          <section className="flex min-h-0 flex-col items-center justify-center rounded-2xl border border-cyan-400/20 bg-black/30 p-4">
            <div className="relative flex h-64 w-64 items-center justify-center">
              <div className="absolute inset-0 rounded-full border border-dashed border-cyan-400/40 animate-[spin_20s_linear_infinite]" />
              <div className="absolute inset-4 rounded-full border border-cyan-300/50 animate-[spin_12s_linear_infinite_reverse]" />
              <div className="absolute inset-10 rounded-full border border-dotted border-cyan-200/40 animate-[spin_8s_linear_infinite]" />
              <div className={`flex h-28 w-28 flex-col items-center justify-center rounded-full bg-cyan-500/10 shadow-[0_0_80px_rgba(34,211,238,0.5)] ${
                  busy || listening ? "animate-pulse" : ""}`}>
                <div className="text-lg font-bold tracking-[0.35em] text-cyan-200">JARVIS</div>
                <div className="text-[10px] tracking-[0.3em] text-cyan-300/70">AI CORE</div>
              </div>
            </div>
            <div className="mt-4 grid w-full max-w-md grid-cols-2 gap-3">
              {status.map((s) => (
                <div key={s.label} className="rounded-xl border border-cyan-400/20 bg-cyan-400/5 p-3">
                  <div className="text-[10px] uppercase tracking-widest text-cyan-100/50">{s.label}</div>
                  <div className="text-sm text-cyan-200">{s.value}</div>
                </div>
              ))}
            </div>
          </section>

          {/* Chat */}
          <section className="flex min-h-0 flex-col rounded-2xl border border-cyan-400/20 bg-black/30 p-4">
            <div className="mb-2 text-xs uppercase tracking-[0.3em] text-cyan-300">Conversation</div>
            <div className="flex-1 space-y-3 overflow-y-auto pr-1">
              {messages.map((m, i) => (
                <div key={i} className={`flex ${m.role === "user" ? "justify-end" : "justify-start"}`}>
                  <div className={`max-w-[85%] whitespace-pre-wrap rounded-2xl px-4 py-2 text-sm ${
                      m.role === "user"
                        ? "bg-blue-600 text-white"
                        : "border border-cyan-400/30 bg-cyan-400/10 text-cyan-50"}`}>
                    {m.text}
                  </div>
                </div>
              ))}
              {busy && <div className="text-sm text-cyan-300/70 animate-pulse">Jarvis is thinking...</div>}
              <div ref={endRef} />
            </div>
            <div className="mt-3 flex gap-2">
              <input value={input} onChange={(e) => setInput(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && send()}
                placeholder="Type a message..."
                className="min-w-0 flex-1 rounded-xl border border-cyan-400/30 bg-black/40 px-4 py-2 text-sm outline-none placeholder:text-cyan-100/30 focus:border-cyan-300" />
              <button onClick={() => send()}
                className="rounded-xl bg-cyan-500 px-5 py-2 text-sm font-semibold text-black hover:bg-cyan-400">
                Send
              </button>
            </div>
          </section>
        </div>

        {/* Talk bar */}
        <button onClick={toggleMic}
          className={`mt-4 rounded-full border px-8 py-3 text-sm font-semibold tracking-[0.3em] ${
            listening
              ? "border-red-400 bg-red-500/20 text-red-200 animate-pulse"
              : "border-cyan-400/60 bg-cyan-400/10 text-cyan-200 hover:bg-cyan-400/20"}`}>
          {listening ? "I AM LISTENING... (TAP TO STOP)" : "TALK TO JARVIS"}
        </button>
      </main>
    </div>
  );
}
