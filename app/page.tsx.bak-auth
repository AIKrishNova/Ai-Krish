/* eslint-disable @typescript-eslint/no-explicit-any */
"use client";

import { useEffect, useRef, useState, type CSSProperties } from "react";
import AttachmentTray, { type Attachment } from "../components/AttachmentTray";
import CameraModal from "../components/CameraModal";
import { prepareImage } from "../lib/clientImage";
import { DEFAULT_LIMITS } from "../lib/files/limits";

type Msg = { role: "user" | "jarvis"; text: string; images?: string[]; notes?: string[]; explanation?: string };

const MENU = ["Command Center", "AI Core", "Chat", "Tasks", "Memory", "Tools & Skills"];

const COURSE = [
  "1. Networking basics (TCP/IP, DNS, HTTP)",
  "2. Linux command line",
  "3. Security fundamentals, ethics and the law",
  "4. Build a safe home lab (VirtualBox, Kali, practice VMs)",
  "5. Reconnaissance and scanning (Nmap) in your lab",
  "6. Web security and the OWASP Top 10",
  "7. Passwords and authentication attacks (in your lab)",
  "8. Exploitation basics on legal practice targets",
  "9. Privilege escalation basics",
  "10. Reporting and defense",
  "11. CTF practice (picoCTF, TryHackMe, OverTheWire)",
];

// Speech engines often hear "Krish" as Chris / Krishna, so accept those too.
const WAKE = /\b(?:hey|hay|hi|hello|ok|okay|a|ay|hei)[\s,]+(?:krish\w*|kris\w*|chris\w*|christ\w*|krush|crush|grish\w*|cris\w*|kreesh\w*|krisha)\b[\s,.!?]*/i;

const LOOKS: Record<string, { c1: string; c2: string; glow: string; label: string }> = {
  idle: { c1: "#bfdbfe", c2: "#3b82f6", glow: "rgba(59,130,246,0.35)", label: 'Turn on "Hey Krish" or tap Talk' },
  standby: { c1: "#c7d2fe", c2: "#6366f1", glow: "rgba(99,102,241,0.35)", label: 'Say "Hey Krish"' },
  listening: { c1: "#a7f3d0", c2: "#10b981", glow: "rgba(16,185,129,0.45)", label: "Listening..." },
  thinking: { c1: "#fde68a", c2: "#f59e0b", glow: "rgba(245,158,11,0.40)", label: "Thinking..." },
  speaking: { c1: "#ddd6fe", c2: "#8b5cf6", glow: "rgba(139,92,246,0.45)", label: "Speaking..." },
};

export default function Home() {
  const [messages, setMessages] = useState<Msg[]>([
    { role: "jarvis", text: 'Good day. I am AI Krish. Turn on "Hey Krish" and say my name, or press Talk to AI Krish and speak.' },
  ]);
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [micOpen, setMicOpen] = useState(false);
  const [wakeOn, setWakeOn] = useState(false);
  const [awake, setAwake] = useState(false);
  const [speaking, setSpeaking] = useState(false);
  const [voiceOn, setVoiceOn] = useState(true);
  const [lastProvider, setLastProvider] = useState<string | null>(null);
  const [micError, setMicError] = useState("");
  const [locked, setLocked] = useState(false);
  const [passInput, setPassInput] = useState("");
  const [notes, setNotes] = useState<string[]>([]);
  const [done, setDone] = useState<number[]>([]);
  const [tutor, setTutor] = useState(false);
  const [panel, setPanel] = useState(false);
  const [hydrated, setHydrated] = useState(false);
  const [heard, setHeard] = useState("");
  const [now, setNow] = useState<Date | null>(null);
  const [attachments, setAttachments] = useState<Attachment[]>([]);
  const [preparing, setPreparing] = useState(0);
  const [uploadPct, setUploadPct] = useState<number | null>(null);
  const [statusText, setStatusText] = useState("");
  const [think, setThink] = useState(false);
  const [attachMenu, setAttachMenu] = useState(false);
  const [cameraOpen, setCameraOpen] = useState(false);
  const [dragOver, setDragOver] = useState(false);
  const [attachNote, setAttachNote] = useState("");
  const fileInputRef = useRef<HTMLInputElement>(null);
  const captureInputRef = useRef<HTMLInputElement>(null);
  const attachRef = useRef<Attachment[]>([]);
  const [details, setDetails] = useState("");

  const endRef = useRef<HTMLDivElement>(null);
  const recRef = useRef<any>(null);
  const runningRef = useRef(false);
  const wakeRef = useRef(false);
  const oneShotRef = useRef(false);
  const awakeRef = useRef(false);
  const awakeTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const speakingRef = useRef(false);
  const speakEndRef = useRef(0);
  const utterRef = useRef<any>(null);
  const watchRef = useRef<ReturnType<typeof setInterval> | null>(null);

  useEffect(() => {
    setNow(new Date());
    const t = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, busy]);

  useEffect(() => {
    try {
      const m = localStorage.getItem("krish-messages");
      if (m) {
        const arr = JSON.parse(m);
        if (Array.isArray(arr) && arr.length) setMessages(arr);
      }
      const n = localStorage.getItem("krish-notes");
      if (n) setNotes(JSON.parse(n));
      const d = localStorage.getItem("krish-done");
      if (d) setDone(JSON.parse(d));
      setTutor(localStorage.getItem("krish-tutor") === "1");
      setThink(localStorage.getItem("krish-think") === "1");
    } catch {}
    setHydrated(true);
  }, []);

  useEffect(() => {
    if (!hydrated) return;
    try {
      localStorage.setItem("krish-messages", JSON.stringify(messages.slice(-60)));
      localStorage.setItem("krish-notes", JSON.stringify(notes));
      localStorage.setItem("krish-done", JSON.stringify(done));
      localStorage.setItem("krish-tutor", tutor ? "1" : "0");
      localStorage.setItem("krish-think", think ? "1" : "0");
    } catch {}
  }, [messages, notes, done, tutor, think, hydrated]);

  useEffect(() => {
    return () => {
      wakeRef.current = false;
      try { recRef.current?.stop(); } catch {}
      if (typeof window !== "undefined") window.speechSynthesis?.cancel();
    };
  }, []);

  useEffect(() => {
    attachRef.current = attachments;
  }, [attachments]);

  useEffect(() => {
    return () => attachRef.current.forEach((a) => URL.revokeObjectURL(a.previewUrl));
  }, []);

  function memoryText() {
    const parts: string[] = notes.map((n) => "- " + n);
    if (tutor) {
      parts.push(
        "Ethical hacking course. Completed: " +
          (done.length ? done.map((i) => COURSE[i]).join("; ") : "nothing yet") +
          ". Next: " +
          (COURSE.find((_, i) => !done.includes(i)) ?? "all modules done")
      );
    }
    return parts.join("\n");
  }

  function speak(text: string) {
    if (!voiceOn || !("speechSynthesis" in window)) return;
    const synth = window.speechSynthesis;
    synth.cancel();
    const u = new SpeechSynthesisUtterance(text);
    utterRef.current = u; // keep a reference so Chrome does not drop the end event
    const done = () => {
      if (watchRef.current) { clearInterval(watchRef.current); watchRef.current = null; }
      speakingRef.current = false;
      speakEndRef.current = Date.now();
      setSpeaking(false);
    };
    u.onstart = () => {
      speakingRef.current = true;
      setSpeaking(true);
      // Safety net: Chrome sometimes never fires onend, which would leave the mic deaf.
      if (watchRef.current) clearInterval(watchRef.current);
      watchRef.current = setInterval(() => { if (!synth.speaking) done(); }, 500);
    };
    u.onend = done;
    u.onerror = done;
    synth.speak(u);
  }

  async function send(textIn?: string) {
    const text = (textIn ?? input).trim();
    if ((!text && attachments.length === 0) || busy) return;
    const rm = text.match(/^(?:remember|note)(?: that)?[:,\s]+(.{3,300})$/i);
    if (rm) {
      setNotes((n) => [...n, rm[1].trim()].slice(-30));
      setMessages((m) => [...m, { role: "user", text }, { role: "jarvis", text: "Saved. I will remember that." }]);
      setInput("");
      return;
    }
    if (attachments.length > 0) {
      await sendWithImages(text);
      return;
    }
    const next: Msg[] = [...messages, { role: "user", text }];
    setMessages(next);
    setInput("");
    setBusy(true);
    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-krish-pass": (() => { try { return localStorage.getItem("krish-pass") ?? ""; } catch { return ""; } })() },
        body: JSON.stringify({ messages: next, tutor, memory: memoryText() }),
      });
      if (res.status === 401) {
        setMessages((m) => m.slice(0, -1));
        setInput(text);
        setLocked(true);
        setBusy(false);
        return;
      }
      const data = await res.json();
      const reply: string = data.reply ?? `Error: ${data.error ?? "no reply"}`;
      setMessages((m) => [...m, { role: "jarvis", text: reply }]);
      if (data.provider) setLastProvider(data.provider);
      if (data.reply) speak(reply);
    } catch {
      setMessages((m) => [...m, { role: "jarvis", text: "Error: could not reach the server." }]);
    }
    setBusy(false);
  }

  function passcode() {
    try { return localStorage.getItem("krish-pass") ?? ""; } catch { return ""; }
  }

  function speakable(reply: string) {
    const m = reply.match(/Answer:\s*([\s\S]*?)(?:\n\s*What I can see:|$)/i);
    return (m ? m[1] : reply).replace(/[*#_`]/g, "").trim().slice(0, 500);
  }

  async function addFiles(list: FileList | File[]) {
    const incoming = Array.from(list);
    if (incoming.length === 0) return;
    setAttachNote("");
    const problems: string[] = [];
    for (const file of incoming) {
      if (attachRef.current.length >= DEFAULT_LIMITS.maxFiles) {
        problems.push(`Only ${DEFAULT_LIMITS.maxFiles} photos can be attached to one message.`);
        break;
      }
      setPreparing((n) => n + 1);
      const r = await prepareImage(file);
      setPreparing((n) => n - 1);
      if ("error" in r) {
        problems.push(r.error);
        continue;
      }
      const total = attachRef.current.reduce((sum, a) => sum + a.file.size, 0) + r.file.size;
      if (total > DEFAULT_LIMITS.maxTotalBytes) {
        problems.push(`${file.name}: skipped, because the photos in one message can total at most ${(DEFAULT_LIMITS.maxTotalBytes / 1_000_000).toFixed(0)} MB.`);
        continue;
      }
      const item: Attachment = { id: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`, file: r.file, previewUrl: URL.createObjectURL(r.file) };
      attachRef.current = [...attachRef.current, item];
      setAttachments(attachRef.current);
    }
    if (problems.length) setAttachNote(Array.from(new Set(problems)).join(" "));
  }

  function removeAttachment(id: string) {
    const gone = attachRef.current.find((a) => a.id === id);
    if (gone) URL.revokeObjectURL(gone.previewUrl);
    attachRef.current = attachRef.current.filter((a) => a.id !== id);
    setAttachments(attachRef.current);
    if (attachRef.current.length === 0) setDetails("");
    setAttachNote("");
  }

  function openCamera() {
    setAttachMenu(false);
    if (typeof navigator !== "undefined" && typeof navigator.mediaDevices?.getUserMedia === "function") {
      setCameraOpen(true);
    } else {
      setAttachNote("Live camera is not available in this browser (it needs https or localhost). Opening your device camera or file picker instead.");
      captureInputRef.current?.click();
    }
  }

  function postAnalyze(form: FormData): Promise<{ status: number; final?: any; error?: string }> {
    return new Promise((resolve) => {
      const xhr = new XMLHttpRequest();
      xhr.open("POST", "/api/analyze");
      xhr.setRequestHeader("x-krish-pass", passcode());
      xhr.timeout = 120000;
      let seen = 0;
      let final: any = null;
      const pump = () => {
        const t = xhr.responseText;
        const nl = t.lastIndexOf("\n");
        if (nl < seen) return;
        const chunk = t.slice(seen, nl + 1);
        seen = nl + 1;
        for (const line of chunk.split("\n")) {
          if (!line.trim()) continue;
          try {
            const o = JSON.parse(line);
            if (o.type === "status") setStatusText(o.message);
            else final = o;
          } catch {}
        }
      };
      xhr.upload.onprogress = (e) => { if (e.lengthComputable) setUploadPct(Math.round((e.loaded / e.total) * 100)); };
      xhr.upload.onload = () => { setUploadPct(100); setStatusText("Waiting for the analysis..."); };
      xhr.onprogress = () => { if (xhr.status === 200) pump(); };
      xhr.onerror = () => resolve({ status: 0, error: "Could not reach the server. Check your connection and try again." });
      xhr.ontimeout = () => resolve({ status: 0, error: "The analysis took too long and was stopped. Try fewer or smaller photos." });
      xhr.onload = () => {
        if (xhr.status === 200) {
          pump();
          resolve({ status: 200, final });
        } else {
          let msg = "";
          try { msg = JSON.parse(xhr.responseText).error; } catch {}
          resolve({ status: xhr.status, error: msg || `Server error ${xhr.status}.` });
        }
      };
      xhr.send(form);
    });
  }

  async function sendWithImages(text: string) {
    const files = attachments.map((a) => a.file);
    const shown = text || "Analyse this photo.";
    const history = messages
      .filter((m) => !m.text.startsWith("Error:"))
      .slice(-10)
      .map((m) => ({ role: m.role, text: m.text }));
    const form = new FormData();
    files.forEach((f) => form.append("files", f, f.name));
    form.append("question", text);
    form.append("context", details.trim());
    form.append("think", think ? "1" : "0");
    form.append("history", JSON.stringify(history));
    form.append("memory", memoryText());

    setMessages((m) => [...m, { role: "user", text: shown, images: files.map((f) => f.name) }]);
    setInput("");
    setAttachNote("");
    setBusy(true);
    setUploadPct(0);
    setStatusText("Uploading...");
    const r = await postAnalyze(form);
    setUploadPct(null);
    setStatusText("");

    if (r.status === 401) {
      setMessages((m) => m.slice(0, -1));
      setInput(text);
      setLocked(true);
    } else if (r.status === 200 && r.final?.type === "result") {
      const f = r.final;
      const notes: string[] = (f.skipped ?? []).map((x: any) => `${x.file}: ${x.reason}`);
      setMessages((m) => [...m, { role: "jarvis", text: f.reply, notes: notes.length ? notes : undefined, explanation: f.explanation }]);
      if (f.provider) setLastProvider(f.provider);
      speak(speakable(f.reply));
    } else {
      const f = r.final;
      const why = r.status === 200 ? f?.error || "The analysis did not finish." : r.error;
      const notes: string[] = (f?.skipped ?? []).map((x: any) => `${x.file}: ${x.reason}`);
      setMessages((m) => [...m, { role: "jarvis", text: `Error: ${why}`, notes: notes.length ? notes : undefined }]);
    }
    setBusy(false);
  }

  const sendRef = useRef(send);
  sendRef.current = send;

  function clearAwake() {
    awakeRef.current = false;
    setAwake(false);
    if (awakeTimer.current) clearTimeout(awakeTimer.current);
  }

  function stopRec() {
    try { recRef.current?.stop(); } catch {}
  }

  function setAwakeNow() {
    awakeRef.current = true;
    setAwake(true);
    if (awakeTimer.current) clearTimeout(awakeTimer.current);
    awakeTimer.current = setTimeout(() => {
      clearAwake();
      if (oneShotRef.current) stopRec();
    }, 9000);
  }

  function handleFinal(text: string) {
    // Ignore anything heard while AI Krish is talking (or just after), so it does not hear itself.
    setHeard((prev) => (prev ? prev + " | " : "") + text.trim());
    if ((speakingRef.current && window.speechSynthesis.speaking) || Date.now() - speakEndRef.current < 900) return;
    const t = text.trim();
    if (!t) return;
    if (awakeRef.current) {
      clearAwake();
      sendRef.current(t);
      if (oneShotRef.current) stopRec();
      return;
    }
    const m = t.match(WAKE);
    if (m) {
      const rest = t.slice((m.index ?? 0) + m[0].length).trim();
      if (rest.length > 1) sendRef.current(rest);
      else setAwakeNow();
    }
  }

  function startRec(): boolean {
    if (runningRef.current) return true;
    const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (!SR) {
      alert("Voice input needs Google Chrome. Please open this page in Chrome.");
      return false;
    }
    const rec = new SR();
    rec.lang = "en-IN";
    rec.continuous = true;
    rec.interimResults = false;
    rec.onstart = () => { runningRef.current = true; setMicOpen(true); };
    rec.onend = () => {
      runningRef.current = false;
      setMicOpen(false);
      // Chrome stops listening after a quiet spell, so reopen it while "Hey Krish" is on.
      if (wakeRef.current) setTimeout(() => { if (wakeRef.current) startRec(); }, 400);
    };
    rec.onerror = (e: any) => {
      if (e?.error === "not-allowed" || e?.error === "service-not-allowed") {
        wakeRef.current = false;
        setWakeOn(false);
        clearAwake();
        setMicError("Microphone is blocked. Allow it in the browser address bar, then try again.");
      }
    };
    rec.onresult = (e: any) => {
      for (let i = e.resultIndex; i < e.results.length; i++) {
        if (e.results[i].isFinal) handleFinal(e.results[i][0].transcript);
      }
    };
    recRef.current = rec;
    try { rec.start(); } catch { if (wakeRef.current) setTimeout(() => { if (wakeRef.current) startRec(); }, 700); }
    return true;
  }

  function toggleWake() {
    if (wakeOn) {
      wakeRef.current = false;
      setWakeOn(false);
      clearAwake();
      stopRec();
      return;
    }
    setMicError("");
    wakeRef.current = true;
    oneShotRef.current = false;
    setWakeOn(true);
    if (!startRec()) { wakeRef.current = false; setWakeOn(false); }
  }

  function talk() {
    if (awake) {
      clearAwake();
      if (!wakeRef.current) stopRec();
      return;
    }
    setMicError("");
    if ("speechSynthesis" in window) window.speechSynthesis.cancel();
    oneShotRef.current = !wakeRef.current;
    setAwakeNow();
    if (!startRec()) clearAwake();
  }

  const mode = busy ? "thinking" : speaking ? "speaking" : awake ? "listening" : wakeOn ? "standby" : "idle";
  const look = LOOKS[mode];

  const status = [
    { label: "AI Core", value: busy ? "Thinking..." : "Online" },
    { label: "Brain", value: lastProvider ?? "Auto (multi-provider)" },
    { label: "Voice", value: voiceOn ? "On" : "Muted" },
    { label: "Microphone", value: awake ? "Listening" : wakeOn ? 'Waiting for "Hey Krish"' : micOpen ? "Open" : "Idle" },
  ];

  return (
    <div className="flex h-screen bg-slate-50 text-slate-900">
      <style>{`
        .orbwrap{position:relative;width:16rem;height:16rem;display:flex;align-items:center;justify-content:center}
        .orb{position:relative;width:9rem;height:9rem;border-radius:9999px;
          background:radial-gradient(circle at 35% 28%,#fff 0%,var(--c1) 38%,var(--c2) 100%);
          box-shadow:0 0 70px var(--glow),inset 0 -10px 30px rgba(0,0,0,.12);
          transition:background .4s,box-shadow .4s;animation:orb-breathe 4s ease-in-out infinite}
        .ring{position:absolute;inset:3.5rem;border-radius:9999px;border:2px solid var(--c2);opacity:0;pointer-events:none}
        .listening .ring,.speaking .ring{animation:orb-ripple 2.4s ease-out infinite}
        .listening .r2,.speaking .r2{animation-delay:.8s}
        .listening .r3,.speaking .r3{animation-delay:1.6s}
        .standby .orb{animation:orb-breathe 3s ease-in-out infinite}
        .standby .r1{opacity:.3}
        .listening .orb{animation:orb-listen 1.1s ease-in-out infinite}
        .speaking .orb{animation:orb-speak .7s ease-in-out infinite}
        .thinking .orb{animation:orb-breathe 1.2s ease-in-out infinite}
        .thinking .r1{inset:2.5rem;opacity:1;border:3px solid transparent;border-top-color:var(--c2);border-right-color:var(--c2);animation:orb-spin 1s linear infinite}
        .orbtext{position:absolute;font-size:.8rem;font-weight:700;letter-spacing:.3em;color:#1e293b;opacity:.75}
        @keyframes orb-breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
        @keyframes orb-listen{0%,100%{transform:scale(1)}50%{transform:scale(1.13)}}
        @keyframes orb-speak{0%,100%{transform:scale(1)}30%{transform:scale(1.09)}60%{transform:scale(.97)}}
        @keyframes orb-ripple{0%{transform:scale(.95);opacity:.55}100%{transform:scale(1.9);opacity:0}}
        @keyframes orb-spin{to{transform:rotate(360deg)}}
      `}</style>

      {locked && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-white/90">
          <div className="w-80 rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
            <div className="mb-3 text-sm font-semibold text-slate-800">Enter passcode to use AI Krish</div>
            <input type="password" autoFocus value={passInput}
              onChange={(e) => setPassInput(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === "Enter") {
                  try { localStorage.setItem("krish-pass", passInput); } catch {}
                  setPassInput("");
                  setLocked(false);
                }
              }}
              placeholder="Passcode"
              className="mb-3 w-full rounded-xl border border-slate-300 px-4 py-2 text-sm outline-none focus:border-blue-500" />
            <button
              onClick={() => {
                try { localStorage.setItem("krish-pass", passInput); } catch {}
                setPassInput("");
                setLocked(false);
              }}
              className="w-full rounded-xl bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-500">
              Unlock
            </button>
          </div>
        </div>
      )}

      {panel && (
        <div className="fixed inset-0 z-40 overflow-y-auto bg-white/95 p-4">
          <div className="mx-auto max-w-2xl rounded-2xl border border-slate-200 bg-white p-5 shadow-lg">
            <div className="mb-4 flex items-center justify-between">
              <div className="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">Memory and learning</div>
              <button onClick={() => setPanel(false)}
                className="rounded-lg border border-slate-300 px-3 py-1 text-sm text-slate-700 hover:bg-slate-100">
                Close
              </button>
            </div>

            <div className="mb-1 text-xs uppercase tracking-widest text-slate-500">Saved notes</div>
            <div className="mb-2 text-xs text-slate-400">Type or say: remember that ...</div>
            {notes.length === 0 && <div className="mb-3 text-sm text-slate-400">Nothing saved yet.</div>}
            <ul className="mb-3 space-y-1">
              {notes.map((n, i) => (
                <li key={i} className="flex items-start justify-between gap-2 rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-800">
                  <span>{n}</span>
                  <button onClick={() => setNotes((x) => x.filter((_, j) => j !== i))}
                    className="text-slate-400 hover:text-red-600">x</button>
                </li>
              ))}
            </ul>

            <div className="mb-1 mt-4 text-xs uppercase tracking-widest text-slate-500">
              Ethical hacking course ({done.length}/{COURSE.length})
            </div>
            <ul className="mb-3 space-y-1">
              {COURSE.map((c, i) => (
                <li key={c}>
                  <label className="flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm text-slate-800 hover:bg-slate-50">
                    <input type="checkbox" checked={done.includes(i)}
                      onChange={() => setDone((d) => (d.includes(i) ? d.filter((x) => x !== i) : [...d, i]))} />
                    {c}
                  </label>
                </li>
              ))}
            </ul>
            <div className="mb-4 text-xs text-slate-500">
              Turn Tutor on, then ask: teach me the next module. Practice only in your own lab or on legal platforms such as TryHackMe, OverTheWire, PortSwigger Web Security Academy and picoCTF.
            </div>

            <div className="flex flex-wrap gap-2">
              <button onClick={() => setMessages([{ role: "jarvis", text: "Chat cleared. How can I help?" }])}
                className="rounded-lg border border-slate-300 px-3 py-1 text-sm text-slate-700 hover:bg-slate-100">
                Clear chat history
              </button>
              <button onClick={() => setNotes([])}
                className="rounded-lg border border-slate-300 px-3 py-1 text-sm text-slate-700 hover:bg-slate-100">
                Clear all notes
              </button>
            </div>
            <div className="mt-3 text-xs text-slate-400">
              Saved only in this browser on this device. It does not sync between your Mac and iPhone.
            </div>
          </div>
        </div>
      )}

      {/* Sidebar */}
      <aside className="hidden w-56 flex-col border-r border-slate-200 bg-white p-4 md:flex">
        <div className="mb-6 text-lg font-bold tracking-[0.3em] text-blue-600">AI KRISH</div>
        {MENU.map((item) => (
          <div key={item}
            className={`mb-2 rounded-lg px-3 py-2 text-sm ${
              item === "Command Center"
                ? "border border-blue-200 bg-blue-50 text-blue-700"
                : "text-slate-400"
            }`}>
            {item}
            {item !== "Command Center" && <span className="ml-2 text-[10px] uppercase">soon</span>}
          </div>
        ))}
      </aside>

      {/* Main */}
      <main className="flex min-w-0 flex-1 flex-col p-4">
        <header className="mb-4 flex items-center justify-between">
          <div>
            <div className="text-xs tracking-[0.3em] text-blue-600">SYSTEM STATUS: OPTIMAL</div>
            <div className="text-2xl font-semibold">
              {now ? now.toLocaleTimeString() : "--:--:--"}
              <span className="ml-3 text-sm font-normal text-slate-500">
                {now ? now.toLocaleDateString(undefined, { weekday: "long", day: "numeric", month: "long" }) : ""}
              </span>
            </div>
          </div>
          <div className="flex flex-wrap justify-end gap-2">
            <button onClick={() => setPanel(true)}
              className="rounded-lg border border-slate-300 bg-white px-3 py-1 text-sm text-slate-700 hover:bg-slate-100">
              Memory
            </button>
            <button onClick={() => setThink(!think)}
              title="Deep analysis for photos: looks first, answers, then checks the answer against the image."
              className={`rounded-lg border px-3 py-1 text-sm ${
                think
                  ? "border-amber-300 bg-amber-50 text-amber-700"
                  : "border-slate-300 bg-white text-slate-700 hover:bg-slate-100"}`}>
              Think Harder: {think ? "On" : "Off"}
            </button>
            <button onClick={() => setTutor(!tutor)}
              className={`rounded-lg border px-3 py-1 text-sm ${
                tutor
                  ? "border-emerald-300 bg-emerald-50 text-emerald-700"
                  : "border-slate-300 bg-white text-slate-700 hover:bg-slate-100"}`}>
              Tutor: {tutor ? "On" : "Off"}
            </button>
            <button onClick={toggleWake}
              className={`rounded-lg border px-3 py-1 text-sm ${
                wakeOn
                  ? "border-indigo-300 bg-indigo-50 text-indigo-700"
                  : "border-slate-300 bg-white text-slate-700 hover:bg-slate-100"}`}>
              Hey Krish: {wakeOn ? "On" : "Off"}
            </button>
            <button onClick={() => { if (voiceOn && "speechSynthesis" in window) window.speechSynthesis.cancel(); setVoiceOn(!voiceOn); }}
              className="rounded-lg border border-slate-300 bg-white px-3 py-1 text-sm text-slate-700 hover:bg-slate-100">
              Voice: {voiceOn ? "On" : "Off"}
            </button>
          </div>
        </header>

        {micError && (
          <div className="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{micError}</div>
        )}

        <div className="grid min-h-0 flex-1 gap-4 lg:grid-cols-2">
          {/* Orb + status */}
          <section className="flex min-h-0 flex-col items-center justify-center rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div className={`orbwrap ${mode}`}
              style={{ "--c1": look.c1, "--c2": look.c2, "--glow": look.glow } as CSSProperties}>
              <span className="ring r1" />
              <span className="ring r2" />
              <span className="ring r3" />
              <div className="orb" />
              <div className="orbtext">KRISH</div>
            </div>
            <div className="mt-1 text-sm font-medium text-slate-600">{look.label}</div>
            {heard && <div className="mt-1 max-w-md truncate text-xs text-slate-400">Heard: {heard.split(" | ").slice(-3).join(" | ")}</div>}
            <div className="mt-4 grid w-full max-w-md grid-cols-2 gap-3">
              {status.map((s) => (
                <div key={s.label} className="rounded-xl border border-slate-200 bg-slate-50 p-3">
                  <div className="text-[10px] uppercase tracking-widest text-slate-500">{s.label}</div>
                  <div className="text-sm text-slate-800">{s.value}</div>
                </div>
              ))}
            </div>
          </section>

          {/* Chat */}
          <section
            onDragOver={(e) => { if (e.dataTransfer.types.includes("Files")) { e.preventDefault(); setDragOver(true); } }}
            onDragLeave={(e) => { if (!e.currentTarget.contains(e.relatedTarget as Node)) setDragOver(false); }}
            onDrop={(e) => { e.preventDefault(); setDragOver(false); addFiles(e.dataTransfer.files); }}
            className={`relative flex min-h-0 flex-col rounded-2xl border bg-white p-4 shadow-sm ${dragOver ? "border-blue-400 ring-2 ring-blue-300" : "border-slate-200"}`}>
            {dragOver && (
              <div className="pointer-events-none absolute inset-0 z-10 flex items-center justify-center rounded-2xl bg-blue-50/90 text-sm font-semibold text-blue-700">
                Drop photos here to attach them
              </div>
            )}
            <div className="mb-2 text-xs uppercase tracking-[0.3em] text-blue-600">Conversation</div>
            <div className="flex-1 space-y-3 overflow-y-auto pr-1">
              {messages.map((m, i) => (
                <div key={i} className={`flex ${m.role === "user" ? "justify-end" : "justify-start"}`}>
                  <div className={`max-w-[85%] whitespace-pre-wrap rounded-2xl px-4 py-2 text-sm ${
                      m.role === "user"
                        ? "bg-blue-600 text-white"
                        : "border border-slate-200 bg-slate-100 text-slate-800"}`}>
                    {m.text}
                    {m.images && m.images.length > 0 && (
                      <div className="mt-1 flex flex-wrap gap-1">
                        {m.images.map((n, k) => (
                          <span key={k} className="max-w-[10rem] truncate rounded-md bg-blue-500/60 px-1.5 py-0.5 text-[11px]">Photo: {n}</span>
                        ))}
                      </div>
                    )}
                    {m.notes && m.notes.length > 0 && (
                      <div className="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2 py-1 text-xs text-amber-800">
                        {m.notes.map((n, k) => <div key={k}>{n}</div>)}
                      </div>
                    )}
                    {m.explanation && <div className="mt-2 border-t border-slate-200 pt-1 text-[11px] text-slate-500">{m.explanation}</div>}
                  </div>
                </div>
              ))}
              {busy && <div className="animate-pulse text-sm text-slate-500">{statusText || "AI Krish is thinking..."}</div>}
              <div ref={endRef} />
            </div>
            <AttachmentTray items={attachments} preparing={preparing} progress={uploadPct} onRemove={removeAttachment} />
            {attachments.length > 0 && (
              <input value={details} onChange={(e) => setDetails(e.target.value.slice(0, 1000))}
                placeholder="Add details about the photo (optional): where, when, what to check"
                className="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-1.5 text-xs outline-none placeholder:text-slate-400 focus:border-blue-500" />
            )}
            {attachNote && <div role="alert" className="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">{attachNote}</div>}
            <div className="relative mt-3 flex gap-2">
              <input ref={fileInputRef} type="file" accept="image/*" multiple hidden
                onChange={(e) => { addFiles(e.target.files ?? []); e.target.value = ""; }} />
              <input ref={captureInputRef} type="file" accept="image/*" capture="environment" hidden
                onChange={(e) => { addFiles(e.target.files ?? []); e.target.value = ""; }} />
              {attachMenu && <div className="fixed inset-0 z-20" onClick={() => setAttachMenu(false)} />}
              {attachMenu && (
                <div className="absolute bottom-full left-0 z-30 mb-2 w-52 overflow-hidden rounded-xl border border-slate-200 bg-white text-sm shadow-lg">
                  <button onClick={() => { setAttachMenu(false); fileInputRef.current?.click(); }}
                    className="block w-full px-4 py-2 text-left text-slate-700 hover:bg-slate-100">Photo or image</button>
                  <button onClick={openCamera}
                    className="block w-full px-4 py-2 text-left text-slate-700 hover:bg-slate-100">Take a photo</button>
                </div>
              )}
              <button onClick={() => setAttachMenu(!attachMenu)} aria-label="Attach a photo" aria-expanded={attachMenu}
                className="flex-none rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                +
              </button>
              <input value={input} onChange={(e) => setInput(e.target.value)}
                onKeyDown={(e) => e.key === "Enter" && send()}
                onPaste={(e) => {
                  const imgs = Array.from(e.clipboardData.files).filter((f) => f.type.startsWith("image/"));
                  if (imgs.length) { e.preventDefault(); addFiles(imgs); }
                }}
                placeholder={attachments.length ? "Ask about the photo(s)..." : "Type a message..."}
                className="min-w-0 flex-1 rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm outline-none placeholder:text-slate-400 focus:border-blue-500" />
              <button onClick={() => send()} disabled={busy}
                className="rounded-xl bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-500 disabled:opacity-60">
                Send
              </button>
            </div>
            <div className="mt-1 text-[11px] text-slate-400">
              {attachments.length > 0
                ? "Photos stay attached for follow-up questions. Remove them when you are done."
                : think
                ? "Think Harder currently applies to photo analysis."
                : "Attach with +, drag and drop, or paste a photo."}
            </div>
          </section>
        </div>

        {/* Talk bar */}
        <button onClick={talk}
          className={`mt-4 rounded-full border px-8 py-3 text-sm font-semibold tracking-[0.3em] ${
            awake
              ? "animate-pulse border-emerald-400 bg-emerald-50 text-emerald-700"
              : "border-blue-300 bg-blue-50 text-blue-700 hover:bg-blue-100"}`}>
          {awake ? "I AM LISTENING... (TAP TO STOP)" : "TALK TO AI KRISH"}
        </button>
      </main>
      {cameraOpen && <CameraModal onCapture={(f) => addFiles([f])} onClose={() => setCameraOpen(false)} />}
    </div>
  );
}
