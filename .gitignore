# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# --- AI KRISH repo additions ---
# The blanket ".env*" rule above would also hide the safe example file, so allow it back in:
!.env.example
# Backups, archives, logs and editor leftovers
*.bak
*.bak-*
*.old
*.old.txt
*.zip
*.tar.gz
*.log
.idea/
.vscode/
